{
  "name": "claude-code-slack-bridge",
  "version": "1.0.0",
  "description": "Slack @mentions routed to headless `claude -p` subprocesses, with per-thread session continuity.",
  "type": "module",
  "bin": "./index.ts",
  "scripts": {
    "start": "bun index.ts",
    "dev": "bun --watch index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@slack/socket-mode": "2.0.6",
    "@slack/web-api": "7.15.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/node": "^22.0.0",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
